# Claude Code / Serena / Codex
.claude/*
# Track subagent definitions (.claude/agents/*.md — dev-planner / implementer / evaluator 等)
!.claude/agents/
!.claude/agents/**
# Track dynamic workflow definitions (dev-flow / pr-iterate are Claude workflows)
!.claude/workflows/
!.claude/workflows/**
# Track redgreen-verify.sh opt-in config (issue #356: per-repo test_cmd/verdict_cmd)
!.claude/redgreen.conf
# Track path-scoped rules (dev-flow 内部仕様の遅延読み込み — AGENTS.md から分離)
!.claude/rules/
!.claude/rules/**
# Legacy: skill-config.json は現在リポジトリルートに配置
.serena/
.system/

# External agent skills
.agents/

# Credentials & secrets
client_secret.json
**/client_secret*.json
**/service-account*.json

# Environment variables (user-specific config)
.env

# Workspace config with token references (use *.example.json as template)
**/workspaces.json

# Generated reports
ga_report.json
trends_report.json
content_plan.json

# OAuth tokens (if stored locally)
**/ga_tokens*.json

# Trends cache
.trends_cache/

# Late API upload cache
.late-upload-cache.json

# Node (末尾 / を付けない — worktree 側の node_modules は main checkout への symlink で、
# `node_modules/` は directory にしかマッチせず symlink が untracked のまま残る)
node_modules

# Python
__pycache__/
*.pyc
*.pyo

# Packaged skills
*.skill

# hunk 同梱スキルへの symlink（dotfiles の home-manager activation が nix store へ貼る）
hunk-review

